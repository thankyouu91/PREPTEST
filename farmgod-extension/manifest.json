{
  "manifest_version": 3,
  "name": "FarmGod Planner",
  "version": "1.0.0",
  "description": "Farm planning assistant for Tribal Wars. Scanning and planning are automatic; every attack is still sent by one explicit click or keypress.",
  "permissions": ["storage"],
  "host_permissions": [
    "*://*.tribalwars.net/*",
    "*://*.tribalwars.us/*",
    "*://*.tribalwars.co.uk/*",
    "*://*.tribalwars.nl/*",
    "*://*.tribalwars.com.br/*",
    "*://*.tribalwars.com.pt/*",
    "*://*.tribalwars.ae/*",
    "*://*.tribalwars.asia/*",
    "*://*.tribalwars.works/*",
    "*://*.die-staemme.de/*",
    "*://*.staemme.ch/*",
    "*://*.plemiona.pl/*",
    "*://*.guerrastribales.es/*",
    "*://*.klanhaboru.hu/*",
    "*://*.divokekmeny.cz/*",
    "*://*.divoke-kmene.sk/*",
    "*://*.tribals.it/*",
    "*://*.vojnaplemen.si/*",
    "*://*.triburile.ro/*",
    "*://*.voyna-plemyon.ru/*",
    "*://*.fyletikesmaxes.gr/*",
    "*://*.bujruk.com/*",
    "*://*.klanlar.org/*",
    "*://*.tribalwars.dk/*",
    "*://*.tribalwars.se/*",
    "*://*.no.tribalwars.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.tribalwars.net/*",
        "*://*.tribalwars.us/*",
        "*://*.tribalwars.co.uk/*",
        "*://*.tribalwars.nl/*",
        "*://*.tribalwars.com.br/*",
        "*://*.tribalwars.com.pt/*",
        "*://*.tribalwars.ae/*",
        "*://*.tribalwars.asia/*",
        "*://*.tribalwars.works/*",
        "*://*.die-staemme.de/*",
        "*://*.staemme.ch/*",
        "*://*.plemiona.pl/*",
        "*://*.guerrastribales.es/*",
        "*://*.klanhaboru.hu/*",
        "*://*.divokekmeny.cz/*",
        "*://*.divoke-kmene.sk/*",
        "*://*.tribals.it/*",
        "*://*.vojnaplemen.si/*",
        "*://*.triburile.ro/*",
        "*://*.voyna-plemyon.ru/*",
        "*://*.fyletikesmaxes.gr/*",
        "*://*.bujruk.com/*",
        "*://*.klanlar.org/*",
        "*://*.tribalwars.dk/*",
        "*://*.tribalwars.se/*",
        "*://*.no.tribalwars.com/*"
      ],
      "js": ["src/content/bridge.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/page/*.js"],
      "matches": [
        "*://*.tribalwars.net/*",
        "*://*.tribalwars.us/*",
        "*://*.tribalwars.co.uk/*",
        "*://*.tribalwars.nl/*",
        "*://*.tribalwars.com.br/*",
        "*://*.tribalwars.com.pt/*",
        "*://*.tribalwars.ae/*",
        "*://*.tribalwars.asia/*",
        "*://*.tribalwars.works/*",
        "*://*.die-staemme.de/*",
        "*://*.staemme.ch/*",
        "*://*.plemiona.pl/*",
        "*://*.guerrastribales.es/*",
        "*://*.klanhaboru.hu/*",
        "*://*.divokekmeny.cz/*",
        "*://*.divoke-kmene.sk/*",
        "*://*.tribals.it/*",
        "*://*.vojnaplemen.si/*",
        "*://*.triburile.ro/*",
        "*://*.voyna-plemyon.ru/*",
        "*://*.fyletikesmaxes.gr/*",
        "*://*.bujruk.com/*",
        "*://*.klanlar.org/*",
        "*://*.tribalwars.dk/*",
        "*://*.tribalwars.se/*",
        "*://*.no.tribalwars.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "FarmGod Planner"
  }
}
